# Environment variables — never commit real keys
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Log files — may contain research topics or personal data; local only
**/LOG.md

# Web-research output files — local only; CONTEXT.md is tracked
workflows/web-research/outputs/*.json
workflows/web-research/outputs/*.md
!workflows/web-research/outputs/CONTEXT.md

# Audit report — generated output, local only
workflows/audit/last-report.md

# Link-check report — generated output (only created with --save), local only
workflows/link-check/last-report.md

# Close-out verifier — most recent result, regenerated on every run, local only
workflows/close-out/last-result.json

# Weather workflow — saved locations contain personal place data; local only
workflows/weather/locations.json

# memory/ holds personal memory files (user context, feedback, project decisions); CONTEXT.md is structural and tracked
memory/*
!memory/.gitkeep
!memory/CONTEXT.md

# Personal content — never commit
# user-inputs/ holds personal documents (CVs, health notes, etc.) for USER.md ingestion
user-inputs/*
!user-inputs/.gitkeep
!user-inputs/CONTEXT.md
# USER.md contains the user's name and personal context — excluded so cloners start fresh
USER.md
# Root LOG.md contains personal wiki ingest history and family data (also caught by **/LOG.md above)
/LOG.md
# wikis/ holds personal knowledge base content; directory skeleton kept via .gitkeep
wikis/*
!wikis/.gitkeep
# journal/entries/ holds private journal entries; directory skeleton kept via .gitkeep
# CONTEXT.md is structural documentation (no personal data) and is tracked
journal/entries/*
!journal/entries/.gitkeep
!journal/entries/CONTEXT.md
# conversations/ holds personal saved conversation summaries; directory skeleton kept via .gitkeep
# CONTEXT.md and LOG.md are structural (caught by **/LOG.md above) — only conversation files are personal
conversations/*
!conversations/.gitkeep
!conversations/CONTEXT.md
# reviews/ holds personal weekly review files; directory skeleton kept via .gitkeep
# CONTEXT.md is structural documentation (no personal data) and is tracked
reviews/*
!reviews/.gitkeep
!reviews/CONTEXT.md

# Tool settings — machine-specific, never commit
# settings.local.json contains granted command permissions for this machine; settings.json is project config and IS tracked
.claude/settings.local.json
# .obsidian/ contains Obsidian vault settings; workspace.json changes on every use
.obsidian/

# Session search — archive files and database shards contain personal conversation data
# index_state.json is machine-specific state; CONTEXT.md is structural and tracked
workflows/session-search/data/*
!workflows/session-search/data/.gitkeep
!workflows/session-search/data/CONTEXT.md

# Knowledge graph — generated node/edge indexes; rebuildable and may include
# names from gitignored directories. CONTEXT.md is structural and tracked.
workflows/knowledge-graph/index/*
!workflows/knowledge-graph/index/.gitkeep
!workflows/knowledge-graph/index/CONTEXT.md
# Validation report — generated output (only created with --save); may include
# names drawn from gitignored directories. Local only.
workflows/knowledge-graph/last-report.md

# Personal-data-guard denylist holds the user's personal nouns; the .example is tracked
workflows/personal-data-guard/config/denylist.txt

# Check-for-updates - local last-run timestamp; drives the startup staleness reminder
workflows/check-for-updates/.last-run

# Weekly-review - local runtime state (staleness marker + journal coverage watermark)
workflows/weekly-review/.last-run
workflows/weekly-review/state.json

# Reddit collector — downloaded posts and state are personal/machine-specific content
workflows/reddit-collector/collections/
workflows/reddit-collector/config/feeds.json
workflows/reddit-collector/state/
workflows/reddit-collector/Read *.bat
workflows/reddit-collector/Stop *.bat
workflows/reddit-collector/.reader_server.pid

# rule-hooks fire-log: runtime, machine-specific record of trial-rule fires and
# blocks. Infrastructure, not a logged workflow run - never committed.
workflows/rule-hooks/fire-log.jsonl

# Design-time documents (plans, handovers, proposals, roadmaps) are personal
# working artifacts — never committed. They routinely capture machine-, session-,
# and user-specific context. Durable, generic design decisions live in the tracked
# CONTEXT.md files instead. A genuinely generic forward-looking design doc may be
# tracked only as a deliberate opt-in (give it a non-matching name or explicitly
# un-ignore it after confirming it carries no personal data).
**/*-PLAN.md
**/HANDOVER.md
**/PROPOSAL.md
**/ROADMAP.md

# OS
.DS_Store
Thumbs.db
