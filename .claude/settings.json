                        "shell": "bash"
                    }
                ]
            }
        ],
        "PreCompact": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"$CLAUDE_PROJECT_DIR/workflows/session-search/scripts/archive.py\" --hook",
                        "shell": "bash"
                    }
                ]
            }
        ],
        "Notification": [
            {
                "matcher": "idle_prompt",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"$CLAUDE_PROJECT_DIR/workflows/session-search/scripts/archive.py\" --hook",
                        "shell": "bash"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"$CLAUDE_PROJECT_DIR/workflows/rule-hooks/scripts/run.py\" --ai claude",
                        "shell": "bash",
                        "timeout": 5
                    }
                ]
            },
            {
                "matcher": "Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"$CLAUDE_PROJECT_DIR/workflows/rule-hooks/scripts/run.py\" --ai claude",
                        "shell": "bash",
                        "timeout": 5
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"$CLAUDE_PROJECT_DIR/workflows/rule-hooks/scripts/run.py\" --reinject",
