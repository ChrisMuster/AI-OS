# Book Dragon — environment variables template
# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real keys or personal details.

# Your contact email — used in User-Agent headers for polite API access
USER_EMAIL=your.email@example.com

# API keys for web research sources
TAVILY_API_KEY=your-tavily-key-here
BRAVE_API_KEY=your-brave-key-here
GUARDIAN_API_KEY=your-guardian-key-here
