# Book Dragon — environment variables template
# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real keys or personal details.

# Your contact email — used in User-Agent headers for polite API access
USER_EMAIL=your.email@example.com

# Default location for the weather workflow (postcode, place name, or saved location name)
WEATHER_DEFAULT_LOCATION=your_postcode_or_location

# API keys for web research sources
TAVILY_API_KEY=your-tavily-key-here
BRAVE_API_KEY=your-brave-key-here
GUARDIAN_API_KEY=your-guardian-key-here

# Subscription sites for paywalled content detection
# Comma-separated list of domains the user has paid subscriptions to.
# When the research pipeline encounters paywalled content from these domains,
# it records the URL and flags it rather than silently discarding it.
# Add specific Substack newsletters by subdomain (e.g. name.substack.com),
# not as a blanket substack.com entry.
# See workflows/web-research/SETUP.md for full details.
SUBSCRIBED_DOMAINS=medium.com,your-substack-newsletter.substack.com
