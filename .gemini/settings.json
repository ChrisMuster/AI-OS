{
  "context": {
    "fileName": ["AGENTS.md", "GEMINI.md"]
  },
  "mcpServers": {
    "biblio-tools": {
      "command": "python",
      "args": [
        "workflows/biblio-tools/scripts/launch.py",
        "workflows/biblio-tools/scripts/server.py"
      ]
    }
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python workflows/session-search/scripts/archive.py --all"
          }
        ]
      }
    ]
  }
}
