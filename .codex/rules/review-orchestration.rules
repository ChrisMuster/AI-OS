# Review orchestration: let an interactive Codex session start, resume and stop a run.
# A run must run outside Codex's sandbox, because it starts Claude and Codex sessions
# and writes its run record. Nothing else is allowed here; see CONTEXT.md.
prefix_rule(
    pattern = ["python", "workflows/review-orchestration/scripts/run.py", "--run"],
    decision = "allow",
    justification = "Start a review-orchestration run the user asked for.",
)
prefix_rule(
    pattern = ["python", "workflows/review-orchestration/scripts/run.py", "--resume"],
    decision = "allow",
    justification = "Resume a review-orchestration run the user asked for.",
)
prefix_rule(
    pattern = ["python", "workflows/review-orchestration/scripts/run.py", "--stop"],
    decision = "allow",
    justification = "Stop a review-orchestration run the user asked for.",
)
